---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const recipes = (await getCollection('recipes')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Filter chips, grouped so choices within a group widen the list and across groups narrow it
const GROUPS: [string, string[]][] = [
  ['Cuisine', ['South Indian', 'North Indian', 'Indian', 'International']],
  ['Dish', ['Curry', 'Rice', 'Soup', 'Pasta & Noodles', 'Breakfast', 'Bread', 'Main', 'Side', 'Chutney', 'Snack', 'Sweet', 'Drink']],
  ['Method & diet', ['Pressure cooker', 'Air fryer', 'Vegetarian']],
];
const used = new Set(recipes.flatMap((r) => r.data.tags));
const groups = GROUPS.map(([name, tags]) => [name, tags.filter((t) => used.has(t))] as const);
const searchText = (r: (typeof recipes)[number]) =>
  [r.data.title, ...r.data.tags, ...r.data.ingredients.map((i) => i.name)].join(' ').toLowerCase();
---

<Base>
  <section class="intro">
    <h1>Recipes that work in my kitchen</h1>
    <p>{recipes.length} recipes, each one cooked, adjusted and cooked again.</p>
  </section>

  <div class="filters no-print">
    <label class="search">
      <span class="visually-hidden">Search recipes</span>
      <input id="search" type="search" placeholder="Search by name or ingredient…" autocomplete="off" />
    </label>
    {groups.map(([name, tags], index) => (
      <div class="group" role="group" aria-labelledby={`group-${index}`}>
        <span class="group-name" id={`group-${index}`}>{name}</span>
        <div class="chips">
          {tags.map((tag) => (
            <button type="button" class="chip" data-tag={tag} aria-pressed="false">{tag}</button>
          ))}
        </div>
      </div>
    ))}
  </div>

  <p id="count" class="count" aria-live="polite">{recipes.length} recipes</p>

  <ul class="grid">
    {recipes.map((recipe) => (
      <li data-tags={JSON.stringify(recipe.data.tags)} data-search={searchText(recipe)}>
        <a href={`${base}recipes/${recipe.id}/`}>
          <h2>{recipe.data.title}</h2>
          <p class="meta">{recipe.data.servings} {recipe.data.servings === 1 ? 'serving' : 'servings'} · {recipe.data.ingredients.length} ingredients</p>
          <p class="tags">{recipe.data.tags.map((t) => <span class="tag">{t}</span>)}</p>
        </a>
      </li>
    ))}
  </ul>
  <p id="empty" class="empty" hidden>No recipes match. Try fewer filters.</p>
</Base>

<script>
  const search = document.querySelector<HTMLInputElement>('#search')!;
  const cards = [...document.querySelectorAll<HTMLLIElement>('.grid li')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const count = document.querySelector('#count')!;
  const empty = document.querySelector<HTMLElement>('#empty')!;

  function update() {
    const words = search.value.toLowerCase().split(/\s+/).filter(Boolean);
    const groups = [...document.querySelectorAll('.group')].map((group) =>
      [...group.querySelectorAll<HTMLButtonElement>('.chip[aria-pressed="true"]')].map((chip) => chip.dataset.tag!),
    );
    let shown = 0;
    for (const card of cards) {
      const tags: string[] = JSON.parse(card.dataset.tags!);
      const matches =
        words.every((word) => card.dataset.search!.includes(word)) &&
        groups.every((selected) => selected.length === 0 || selected.some((tag) => tags.includes(tag)));
      card.hidden = !matches;
      if (matches) shown++;
    }
    count.textContent = `${shown} ${shown === 1 ? 'recipe' : 'recipes'}`;
    empty.hidden = shown > 0;
  }

  search.addEventListener('input', update);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      chip.setAttribute('aria-pressed', String(chip.getAttribute('aria-pressed') !== 'true'));
      update();
    });
  }
</script>

<style>
  .intro { padding: 1.5rem 0 1rem; }
  .intro h1 { font-size: clamp(2rem, 6vw, 2.75rem); margin: 0 0 0.5rem; }
  .intro p { margin: 0; color: var(--muted); }

  .filters { display: grid; gap: 0.75rem; margin: 1.5rem 0 1rem; }

  .search input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--surface);
  }

  .group { display: grid; grid-template-columns: 8rem 1fr; align-items: baseline; gap: 0.5rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }

  .group-name {
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Phones: label above, one swipeable row of chips per group, so recipes show sooner */
  @media (max-width: 40rem) {
    .filters { gap: 0.5rem; }
    .group { grid-template-columns: 1fr; gap: 0.25rem; }
    .chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: -1rem; padding: 0.125rem 1rem; }
    .chips::-webkit-scrollbar { display: none; }
    .chip { flex: none; }
    .intro { padding-top: 0.5rem; }
    .intro h1 { font-size: 1.75rem; }
  }

  .chip {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .chip[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--bg); }

  .count { color: var(--muted); font-size: 0.875rem; margin: 0 0 0.75rem; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }

  .grid a {
    display: block;
    height: 100%;
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .grid a:hover { border-color: var(--accent); }
  .grid h2 { font-size: 1.125rem; margin: 0 0 0.25rem; }
  .meta { margin: 0 0 0.5rem; color: var(--muted); font-size: 0.8125rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.25rem; margin: 0; }
  .empty { color: var(--muted); text-align: center; padding: 2rem 0; }

  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
